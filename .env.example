# GoldCycle settings. Copy to .env (this folder or backend\) and edit.
# .env is gitignored — never commit it.

# ---------------- broker ----------------
# mt5 = real MetaTrader 5 terminal (Windows), sim = random-walk simulator (dev on any OS)
BROKER=mt5
# true  = real MT5 prices, but orders are only logged and paper-filled (nothing is sent)
# false = real orders. Run a full session on DEMO with false before going live.
DRY_RUN=true

# Optional. Leave commented = attach to whatever account the MT5 terminal is logged into.
# If you set them, also tick "Save password" in MT5 so auto-login works after a reboot.
# (Uncomment only with real values — an empty MT5_LOGIN= fails to start.)
# MT5_LOGIN=12345678
# MT5_PASSWORD=
# MT5_SERVER=Exness-MT5Real
# Optional path to the terminal:
# MT5_PATH=C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe

# Blank = auto-detect (*XAU*USD*) / the symbol chosen in Settings.
# Exness Standard accounts use XAUUSDm. XAUUSD247m has no quotes — don't use it.
SYMBOL=
# Magic number on every bot order. The bot only touches positions with this number.
MAGIC=7700501
# How often to poll the price (ms)
POLL_INTERVAL_MS=100

# ---------------- engine ----------------
# false = after a restart the dashboard asks "Resume?" (recommended)
RESUME_ON_RESTART=false

# ---------------- web dashboard ----------------
# Keep 127.0.0.1. NEVER use 0.0.0.0 — that exposes the bot to the internet.
HOST=127.0.0.1
PORT=8000
ADMIN_USERNAME=admin
# Generate with:  cd backend  &&  .venv\Scripts\python -m app.security
ADMIN_PASSWORD_HASH=
SESSION_TTL_HOURS=12

# ---------------- storage (defaults: data\goldcycle.db, logs\) ----------------
# DB_PATH=C:\goldcycle\data\goldcycle.db
# LOG_DIR=C:\goldcycle\logs

# ---------------- simulator (BROKER=sim only) ----------------
SIM_START_PRICE=4000
SIM_SPREAD=0.2
